FLASK_APP=app.py
FLASK_DEBUG=true
PORT=5000

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-it

# Firebase
# Path to your firebase-credentials.json file
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# OR paste the entire JSON string here for cloud deployment
FIREBASE_CREDENTIALS_JSON=

# CORS
FRONTEND_URL=http://localhost:5173
